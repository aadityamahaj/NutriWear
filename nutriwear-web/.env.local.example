# Copy to .env.local and fill in. In production (Vercel) set these as
# Environment Variables in the project settings instead.

# Groq key (server-side only, never exposed to the browser).
# Get one free at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# Upstash Redis — makes live phone<->web sync work across serverless instances
# in production. OPTIONAL for local dev: if these are unset the app falls back
# to an in-memory store (single process) automatically.
# Create a free database at https://console.upstash.com/ and copy the REST
# URL + token from its "REST API" section.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
