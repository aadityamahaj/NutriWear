// Copy this file to `Secrets.xcconfig` and fill in your Groq API key.
// Secrets.xcconfig is gitignored and never committed.
//
// Get a free key at https://console.groq.com/keys
//
// NOTE: xcconfig treats `//` as a comment, even inside a URL value.
// Groq keys don't contain `//`, so this is fine here.

GROQ_API_KEY = gsk_your_key_here

// --- Supabase (optional: enables email sign-in + cloud sync) ---
// Create a free project at https://supabase.com, then Project Settings > API.
//
// IMPORTANT: xcconfig treats `//` as the start of a comment, so DO NOT include
// the "https://" scheme here. Put only the host; the app adds https:// itself.
//   e.g. SUPABASE_URL = abcdefgh.supabase.co
SUPABASE_URL = your_project.supabase.co
SUPABASE_ANON_KEY = your_anon_key_here
