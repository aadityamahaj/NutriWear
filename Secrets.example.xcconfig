// Copy this file to `Secrets.xcconfig` and fill in your Groq API key.
// Secrets.xcconfig is gitignored and never committed.
//
// Get a free key at https://console.groq.com/keys
//
// NOTE: xcconfig treats `//` as a comment, even inside a URL value.
// Groq keys don't contain `//`, so this is fine here.

GROQ_API_KEY = gsk_your_key_here
